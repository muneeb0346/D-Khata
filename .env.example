# D-Khata Environment Variables
# Copy this file to .env.local and fill in your values

# PostgreSQL connection string (NeonDB)
DATABASE_URL="postgresql://user:password@host/dbname"
# Local Docker Postgres (run: docker compose up -d)
# DATABASE_URL=postgresql://dkhata:dkhata@localhost:5432/dkhata

# Sentry error tracking (leave empty to disable; Sentry no-ops when unset)
# Obtain a DSN from https://sentry.io/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry build-time config (optional; only needed for release tracking)
SENTRY_ORG=
SENTRY_PROJECT=
